-- Wrapping to handle exceptions (e.g., if roles or users already exist)
DO $$
BEGIN

-- =================
-- Roles (NOLOGIN)
-- =================
CREATE ROLE openmetadata_admin_role NOLOGIN;
COMMENT ON ROLE openmetadata_admin_role IS 'Role admin pour gérer la base de données de configuration d''OpenMetadata';
GRANT ALL ON DATABASE {{ item.0.name }} TO openmetadata_admin_role WITH GRANT OPTION;
GRANT ALL ON SCHEMA public TO openmetadata_admin_role WITH GRANT OPTION;


-- =================
-- Users (LOGIN)
-- =================
CREATE ROLE openmetadata_admin_user LOGIN PASSWORD 'openmetadata_password';
COMMENT ON ROLE openmetadata_admin_user IS 'Utilisateur de la base de données de configuration d''OpenMetadata';
GRANT openmetadata_admin_role TO openmetadata_admin_user;

EXCEPTION WHEN duplicate_object THEN RAISE NOTICE '%, skipping', SQLERRM USING ERRCODE = SQLSTATE;
END
$$;
